<form id="form-product" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#product">
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></th>
          <th class="text-center col-1">{{ column_image }}</th>
          <th><a href="{{ sort_name }}"{% if sort == 'pd.name' %} class="{{ order|lower }}"{% endif %}>{{ column_name }}</a></th>
          <th class="d-none d-lg-table-cell"><a href="{{ sort_model }}"{% if sort == 'p.model' %} class="{{ order|lower }}"{% endif %}>{{ column_model }}</a></th>
          <th class="text-end"><a href="{{ sort_price }}"{% if sort == 'p.price' %} class="{{ order|lower }}"{% endif %}>{{ column_price }}</a></th>
          <th class="text-end"><a href="{{ sort_quantity }}"{% if sort == 'p.quantity' %} class="{{ order|lower }}"{% endif %}>{{ column_quantity }}</a></th>
          <th class="text-end"><a href="{{ sort_order }}"{% if sort == 'p.sort_order' %} class="{{ order|lower }}"{% endif %}>{{ column_sort_order }}</a></th>
          <th class="text-center">{{ column_status }}</th>
          <th class="text-end">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if products %}
          {% for product in products %}
            <tr class="{% if not product.variant %}table-warning{% endif %} {% if not product.status %}table-active opacity-50{% endif %}">
              <td class="text-center"><input type="checkbox" name="selected[]" value="{{ product.product_id }}" class="form-check-input"/></td>
              <td class="text-center" data-quick-edit="image" data-quick-edit-type="image" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id">
                <div class="border rounded d-inline-block">
                  <img src="{{ product.image }}" alt="" title="" id="thumb-quick-{{ product.product_id }}" data-oc-toggle="image" data-oc-target="#input-quick-{{ product.product_id }}-image" data-oc-thumb="#thumb-quick-{{ product.product_id }}" data-oc-placeholder="{{ placeholder }}" class="img-fluid" style="width: 40px; height: 40px; cursor: pointer;"/>
                  <input type="hidden" name="quick-image-{{ product.product_id }}" value="{{ product.image_raw }}" id="input-quick-{{ product.product_id }}-image"/>
                </div>
              </td>
              <td data-quick-edit="name" data-quick-edit-type="text" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.name }}">{{ product.name }}</td>
              <td class="d-none d-lg-table-cell" data-quick-edit="model" data-quick-edit-type="text" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.model }}">{{ product.model }}</td>
              <td class="text-end" data-quick-edit="price" data-quick-edit-type="number" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.price_raw }}">
                {% if product.special %}<span style="text-decoration: line-through;">{{ product.price }}</span>
                  <br/>
                  <div class="text-danger">{{ product.special }}</div>
                {% else %}
                  {{ product.price }}
                {% endif %}</td>
              <td class="text-end" data-quick-edit="quantity" data-quick-edit-type="number" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.quantity }}">
                {% if product.quantity <= 0 %}
                  <span class="badge bg-warning">{{ product.quantity }}</span>
                {% elseif product.quantity <= 5 %}
                  <span class="badge bg-danger">{{ product.quantity }}</span>
                {% else %}
                  <span class="badge bg-success">{{ product.quantity }}</span>
                {% endif %}</td>
              <td class="text-end" data-quick-edit="sort_order" data-quick-edit-type="number" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.sort_order }}">{{ product.sort_order }}</td>
              <td class="text-center" data-quick-edit="status" data-quick-edit-type="status" data-quick-edit-url="{{ quick_edit_url }}" data-quick-edit-id="{{ product.product_id }}" data-quick-edit-id-field="product_id" data-quick-edit-value="{{ product.status }}"><i class="fa-solid {{ product.status ? 'fa-square-check' : 'fa-square' }}"></i></td>
              <td class="text-end">
                {% if product.variant %}
                  <div class="btn-group">
                    <a href="{{ product.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a>
                    <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"><i class="fa-solid fa-caret-down"></i></button>
                    <div class="dropdown-menu dropdown-menu-end"><a href="{{ product.variant }}" class="dropdown-item"><i class="fa-solid fa-plus"></i> {{ text_variant_add }}</a></div>
                  </div>
                {% else %}
                  <a href="{{ product.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-warning"><i class="fa-solid fa-pencil"></i></a>
                {% endif %}</td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td class="text-center" colspan="9">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="row">
    <div class="col-sm-6 text-start">{{ pagination }}</div>
    <div class="col-sm-6 text-end">{{ results }}</div>
  </div>
</form>

<script src="view/javascript/quickedit.js" type="text/javascript"></script>
