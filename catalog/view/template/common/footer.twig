</main>
<footer>
  <div class="container">
    <div class="row">
      <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="va-footer-brand">
          <p class="va-footer-logo">Vidon Art</p>
          <p class="va-footer-tagline">Oriental Heritage · Modern Craft</p>
          <p class="va-footer-about">{{ text_about }}</p>
          <form id="form-newsletter" method="post" data-oc-toggle="ajax" class="va-newsletter mt-3">
            <label for="input-newsletter" class="form-label">{{ text_newsletter }}</label>
            <div class="input-group">
              <input type="text" name="email" value="" placeholder="{{ text_newsletter_placeholder }}" id="input-newsletter" class="form-control"/>
              <button type="submit" formaction="index.php?route=common/newsletter.save" class="btn">{{ button_subscribe }}</button>
            </div>
            <div id="error-email" class="invalid-feedback"></div>
          </form>
        </div>
      </div>
      {% if informations or blog %}
        <div class="col-6 col-lg-2">
          <h5>{{ text_information }}</h5>
          <ul class="list-unstyled">
            {% if blog %}
              <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            {% endif %}
            {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      <div class="col-6 col-lg-2">
        <h5>{{ text_service }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
          <li><a href="{{ return }}">{{ text_return }}</a></li>
          {% if gdpr %}
            <li><a href="{{ gdpr }}">{{ text_gdpr }}</a></li>
          {% endif %}
          <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
        </ul>
      </div>
      <div class="col-6 col-lg-2">
        <h5>{{ text_extra }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
          {% if affiliate %}
            <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
          {% endif %}
          <li><a href="{{ special }}">{{ text_special }}</a></li>
        </ul>
      </div>
      <div class="col-6 col-lg-2">
        <h5>{{ text_account }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
          <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
        </ul>
      </div>
    </div>
    <div class="va-footer-bottom">
      <p>{{ powered }}</p>
    </div>
  </div>
</footer>
</div>
{{ cookie }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body></html>
