<div class="product-thumb">
  <div class="image"><a href="{{ href }}"><img src="{{ thumb }}" id="va-card-image-{{ product_id }}" alt="{{ name }}" title="{{ name }}" class="img-fluid"/></a>
    {% if special %}<span class="va-badge">{{ text_sale }}</span>{% endif %}
  </div>
  <div class="content">
    <div class="description">
      <h4><a href="{{ href }}">{{ name }}</a></h4>
      {% if price %}
        <div class="price">
          {% if not special %}
            <span class="price-new">{{ price }}</span>
          {% else %}
            <span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
          {% endif %}
          {% if tax %}
            <span class="price-tax">{{ text_tax }} {{ tax }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% if review_status and rating %}
        <div class="rating">
          {% for i in 1..5 %}
            {% if rating < i %}
              <span class="fa-stack"><i class="fa-regular fa-star fa-stack-1x"></i></span>
            {% else %}
              <span class="fa-stack"><i class="fa-solid fa-star fa-stack-1x"></i><i class="fa-regular fa-star fa-stack-1x"></i></span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% if swatches %}
        <div class="va-card-swatches" data-option-id="{{ swatch_option_id }}">
          {% for swatch in swatches %}
            <button type="button" class="va-card-swatch" data-value="{{ swatch.product_option_value_id }}" data-color="{{ swatch.color }}" data-image="{{ swatch.image }}" style="background: {{ swatch.color }};" title="{{ swatch.name }}"></button>
          {% endfor %}
        </div>
      {% endif %}
      <a href="index.php?route=information/custom&product_id={{ product_id }}" class="va-customize">{{ text_customize }} →</a>
    </div>
    <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart">
      <div class="button">
        <button type="submit" formaction="{{ cart_add }}" data-bs-toggle="tooltip" title="{{ button_cart }}"><i class="fa-solid fa-shopping-cart"></i></button>
        <button type="submit" formaction="{{ wishlist_add }}" data-bs-toggle="tooltip" title="{{ button_wishlist }}"><i class="fa-solid fa-heart"></i></button>
        <button type="submit" formaction="{{ compare_add }}" data-bs-toggle="tooltip" title="{{ button_compare }}"><i class="fa-solid fa-arrow-right-arrow-left"></i></button>
      </div>
      <input type="hidden" name="product_id" value="{{ product_id }}"/> <input type="hidden" name="quantity" value="{{ minimum }}"/>
    </form>
  </div>
  <script type="text/javascript"><!--
$(document).ready(function() {
    var container = $('#va-card-image-{{ product_id }}').closest('.product-thumb').find('.va-card-swatches');
    var image = $('#va-card-image-{{ product_id }}');

    if (!container.length || !image.length) {
        return;
    }

    var original = image.attr('src');

    container.on('mouseenter', '.va-card-swatch', function() {
        var hover = $(this).data('image');

        if (hover) {
            image.attr('src', hover);
        }
    });

    container.on('mouseleave', function() {
        image.attr('src', original);
    });

    container.on('click', '.va-card-swatch', function() {
        var href = '{{ href|escape('js') }}';

        var sep = href.indexOf('?') !== -1 ? '&' : '?';

        location = href + sep + 'option[' + container.data('option-id') + ']=' + $(this).data('value');
    });
});
//--></script>
</div>
